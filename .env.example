# 心语花园 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== Flask 配置 ====================
# 运行环境: development / production
ENV=production

# Flask 密钥 (用于 session 加密)
SECRET_KEY=change-me-to-a-random-secret

# JWT 签名密钥 (必填，生产环境必须使用随机强密钥)
JWT_SECRET=change-me-to-a-random-jwt-secret

# Flask debug，仅本地调试设为 true
FLASK_DEBUG=false

# Zeabur 会注入 PORT；本地可不设置或设为 5000/8080
# PORT=8080

# ==================== 数据库配置 ====================
# 免费演示部署使用临时路径；不要假设可持久保存
DATABASE_PATH=/tmp/heart-garden/heart_garden.db

# ==================== 日志配置 ====================
# 日志目录；免费演示部署使用临时路径
LOG_DIR=/tmp/heart-garden/logs

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== AI 服务配置 (可选) ====================
# 如果使用外部 AI 服务，配置以下环境变量

# DeepSeek API (可选)
# DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI API (可选)
# OPENAI_API_KEY=your-openai-api-key

# ==================== CORS 配置 ====================
# 允许的来源 (逗号分隔)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
